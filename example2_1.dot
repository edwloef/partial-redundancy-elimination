digraph G {
    node [shape=box];

    pre1 [shape=point,style=invis];
    pre1 -> 1 [style=invis];

    post4 [shape=point,style=invis];
    4 -> post4 [style=invis];

    1 [label="",xlabel="1"];
    2 [label="",xlabel="2"];
    3 [label="a = x + y",xlabel="3"];
    4 [label="",xlabel="4"];

    1 -> 2 [color=black];
    2 -> 3 [color=black];
    2 -> 4 [color=black];
    3 -> 2 [color=black];
}
